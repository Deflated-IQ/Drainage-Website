{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drainage-repair-services-oxford",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "."
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}